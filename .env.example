# Browser/PWA: set these in your build environment (for example Vercel). No Google project IDs are hard-coded in frontend source.
# Copy the complete Firebase Web app configuration JSON from Firebase Console.
VITE_FIREBASE_CONFIG='{"apiKey":"your-web-api-key","authDomain":"your-project.firebaseapp.com","projectId":"your-project-id","appId":"your-web-app-id"}'
# Public Web OAuth client ID used only by browser Google Identity Services. This is not a secret.
VITE_GOOGLE_WEB_CLIENT_ID=
# MUST be the deployed HTTPS API URL for production and standalone APK. localhost works only in browser development.
VITE_API_BASE_URL=https://your-wyticle-api.example.com
# OPTIONAL: sign in through your own domain (proxy /__/auth/ to <project>.firebaseapp.com) so redirect sign-in works in browsers that block third-party storage.
# VITE_FIREBASE_AUTH_DOMAIN=app.your-domain.com
# Gemini and every other server secret belong in server/.env, never in a VITE_ variable.
