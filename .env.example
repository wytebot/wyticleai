# Browser/PWA: copy the Firebase WEB app configuration from Firebase Console into one JSON value.
# Android APK uses android-setup/google-services.json and native Firebase Authentication.
VITE_FIREBASE_CONFIG='{"apiKey":"your-web-api-key","authDomain":"your-project.firebaseapp.com","projectId":"your-project-id","appId":"your-web-app-id"}'
# MUST be the deployed HTTPS API URL for production and standalone APK. localhost works only in browser development.
VITE_API_BASE_URL=https://your-wyticle-api.example.com
