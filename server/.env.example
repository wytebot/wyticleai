# REQUIRED — Firebase Admin service-account JSON (single-line JSON).
# Alternative: set GOOGLE_APPLICATION_CREDENTIALS to the path of a service-account file.
# Paste the whole downloaded key file as ONE line inside single quotes: FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT_JSON=

# REQUIRED — Supabase server-side credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED — generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# REQUIRED — Google AI Studio (Gemini) API key. Gemini is the only AI provider: article writing, live research and featured images.
# Create one at https://aistudio.google.com/apikey (GOOGLE_API_KEY is also accepted).
GEMINI_API_KEY=
# Primary writing model, then fallbacks tried in order when a model is overloaded, rate-limited or unavailable.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash
# Featured-image model and fallbacks (Gemini native image generation).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_IMAGE_FALLBACK_MODELS=gemini-2.5-flash-image
# OPTIONAL: extra reasoning for higher quality (minimal | low | medium | high). Thinking tokens are billed as output. Leave empty for the model default.
GEMINI_THINKING_LEVEL=

# REQUIRED — Google OAuth WEB client used for Blogger + Google Drive authorization (not Firebase web sign-in config).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# REQUIRED — public HTTPS frontend and backend URLs in production.
APP_URL=https://your-wyticle-frontend.example.com
API_PUBLIC_URL=https://your-wyticle-api.example.com
# Comma-separated origins allowed to call the API. Native Capacitor localhost origins are allowed automatically.
ALLOWED_ORIGIN=https://your-wyticle-frontend.example.com

# REQUIRED only for paid credit purchases (Flutterwave v4 card flow: card -> PIN -> OTP / 3-D Secure).
FLW_V4_CLIENT_ID=
FLW_V4_CLIENT_SECRET=
# Dashboard -> Settings -> API keys -> Encryption key (base64, 32 bytes). Used to encrypt card number, CVV and PIN.
FLW_V4_ENCRYPTION_KEY=
FLW_V4_BASE_URL=https://developersandbox-api.flutterwave.com
# Packs are priced in USD; customers are charged the naira equivalent at this rate. Update it when the rate moves.
USD_NGN_RATE=1500
# OPTIONAL: webhook secret hash (same value you set in the Flutterwave dashboard) so credits arrive even if the app closes mid-payment.
# Webhook URL: <API_PUBLIC_URL>/api/billing/webhook
FLW_V4_WEBHOOK_SECRET_HASH=

# REQUIRED only when using the external scheduled-publishing worker.
SCHEDULE_WORKER_SECRET=

# OPTIONAL overrides; defaults are provided in code.
PORT=8787
MAX_OUTPUT_TOKENS=9000
MAX_INPUT_TOKENS_ESTIMATE=35000
ENABLE_WEB_SEARCH=true
# Live research uses one Google Search-grounded Gemini request per article / revision (set false to disable and write from model knowledge only).
# Free follow-ups (revise/fix/diagnose) allowed on the 2 free trial articles, per account. After this they are billed.
TRIAL_FOLLOWUP_LIMIT=4

# ---- Pricing: credits are derived from your real Gemini costs. Update these if you change model or Google changes prices. ----
# USD per 1M tokens for GEMINI_MODEL (defaults = gemini-3.5-flash-lite: 0.30 in / 2.50 out). Thinking tokens count as output.
GEMINI_INPUT_USD_PER_M=0.30
GEMINI_OUTPUT_USD_PER_M=2.50
# USD per grounded research request (conservative default 0.035).
SEARCH_USD_PER_CALL=0.035
# USD cost of one generated featured image (conservative default 0.07; gemini-2.5-flash-image is about 0.04).
IMAGE_USD_COST=0.07
# Customers pay this multiple of your API cost. 5 = ~75% gross margin before fees. Raise it to give fewer credits per pack.
CREDIT_MARKUP=5
# Face value of 1 credit. Packs: $4 = 2,000 credits, $9 = 4,860, $18 = 10,350 (with volume bonus).
CREDIT_VALUE_USD=0.002
SCHEDULE_MAX_ACTIVE_PER_USER=10
SCHEDULE_MAX_ACTIVE_GLOBAL=500
SCHEDULE_MAX_DAYS=90
